{
  "name": "worktree-diet",
  "version": "0.2.0",
  "description": "Find and recover generated disk space across Git worktrees.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build": "bun build src/cli.ts --target=bun --outdir=build",
    "check": "bun run lint && bun run typecheck && bun test && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2",
    "@types/bun": "latest",
    "typescript": "latest"
  }
}
